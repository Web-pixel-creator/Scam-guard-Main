# Copy this file to .env and fill in real values. Never commit .env.
# All secrets are server-only. Do NOT put service-role or AI keys in VITE_* vars.

# --- Supabase (client-safe: publishable/anon key + URL) ---
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"
VITE_SUPABASE_URL="https://your-project.supabase.co"
# Operator staging guard only; do not use this to authorize production.
# HOSTED_STAGING_PROJECT_REF="your-staging-project-id"

# --- Supabase service-role (SERVER ONLY — never expose to client) ---
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# --- Admin MFA/AAL2 gate (SERVER ONLY) ---
# Production and Railway require an explicit true/false. Missing, empty and
# invalid values fail closed there; only local development/tests may omit it.
# Use explicit false only for a bounded enrollment or recovery window. When
# true, every admin server action requires an access token whose Supabase Auth
# `aal` claim is `aal2`; database RLS may independently require AAL2.
# REQUIRE_ADMIN_MFA_AAL2="false"

# --- AI explanation provider (SERVER ONLY; OpenAI-compatible Chat Completions) ---
# Optional: if OPENAI_API_KEY is unset, scoring still works and explanation = null.
# OPENAI_BASE_URL lets you point at any OpenAI-compatible gateway (OpenAI,
# OpenRouter, Together, a local server, …). OPENAI_MODEL must be vision-capable
# for screenshot OCR (default: gpt-4o-mini).
OPENAI_API_KEY="sk-your-openai-key"
OPENAI_MODEL="gpt-4o-mini"
OPENAI_BASE_URL="https://api.openai.com/v1"

# --- AI speech output provider (optional, SERVER ONLY) ---
# Used only for opt-in Telegram Voice-out buttons. If unset, the bot replies
# with a short text fallback instead of audio. Gemini TTS is preferred when
# configured; OpenAI TTS stays as a fallback. Do not point OPENAI_TTS_BASE_URL
# at Gemini's OpenAI-compatible chat endpoint.
# GEMINI_TTS_API_KEY="AIza-your-google-ai-studio-key"
# GEMINI_TTS_MODEL="gemini-3.1-flash-tts-preview"
# GEMINI_TTS_VOICE="Kore"
# OPENAI_TTS_API_KEY="sk-your-openai-tts-key"
# OPENAI_TTS_BASE_URL="https://api.openai.com/v1"
# OPENAI_TTS_MODEL="gpt-4o-mini-tts"
# OPENAI_TTS_VOICE="alloy"
# TTS_PROVIDER="gemini"

# --- AI fallback provider (optional, used when primary is circuit-broken) ---
# OPENAI_FALLBACK_BASE_URL="https://openrouter.ai/api/v1"
# OPENAI_FALLBACK_API_KEY="sk-or-..."
# OPENAI_FALLBACK_MODEL="meta-llama/llama-3-8b-instruct"


# --- Hash pepper (SERVER ONLY) ---
# Secret used for HMAC-SHA256 hashing of identifiers (phones, usernames).
# Required in production. Without it, identifier checks/reports fail closed.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
HASH_PEPPER_SECRET="your-long-random-secret-here"
#
# Versioned rotation is opt-in and must follow the additive database migration
# plus the runbook in ai_docs/RECOVERY_AND_KEY_ROTATION.md. During the first
# rotation, keep HASH_PEPPER_SECRET set: the version-aware app treats it as the
# single previous "legacy" pepper while these become the active write slot.
# HASH_PEPPER_ACTIVE_VERSION="v2"
# HASH_PEPPER_ACTIVE_SECRET="your-new-long-random-secret-here"
#
# When rotating an already-versioned active pepper while legacy rows remain,
# keep HASH_PEPPER_SECRET as the final legacy read slot and move the current
# active pair into this explicit previous slot before setting a new active pair.
# The resulting read order is active -> explicit previous -> legacy. Partial or
# duplicate slots fail closed; follow ai_docs/RECOVERY_AND_KEY_ROTATION.md.
# HASH_PEPPER_PREVIOUS_VERSION="v2"
# HASH_PEPPER_PREVIOUS_SECRET="your-previous-long-random-secret-here"

# --- Telegram bot (SERVER ONLY) ---
TELEGRAM_BOT_TOKEN="123456:your-bot-token"
TELEGRAM_WEBHOOK_SECRET="your-webhook-secret"
# Update transport: webhook (compatibility default), polling, or disabled.
# Use disabled for isolated restore drills and any environment that must not
# receive or dispatch Telegram updates.
TELEGRAM_UPDATE_DELIVERY_MODE="webhook"
# Optional public username used to build Family Shield invite links.
# Falls back to scamguard_bot if unset.
TELEGRAM_BOT_USERNAME="scamguard_bot"
# Optional sanitized performance diagnostics for Telegram handlers.
# By default, only stages slower than the threshold are logged.
# Set TELEGRAM_TIMING_LOGS="1" only during short investigations.
# TELEGRAM_TIMING_LOGS="0"
# TELEGRAM_TIMING_LOG_THRESHOLD_MS="1000"
# Optional latency budgets for Telegram AI-assisted paths.
# Low-signal username/phone passports skip AI automatically; these limits bound media paths.
# TELEGRAM_AI_EXPLANATION_TIMEOUT_MS="2500"
# TELEGRAM_AI_EXPLANATION_MAX_ATTEMPTS="1"
# TELEGRAM_IMAGE_ANALYSIS_TIMEOUT_MS="6500"
# TELEGRAM_IMAGE_ANALYSIS_MAX_ATTEMPTS="1"
# TELEGRAM_VOICE_TRANSCRIBE_TIMEOUT_MS="8000"

# --- Node server runtime (Nitro node-server preset) ---
# The production server (dist/server/index.mjs) listens on these.
PORT="3000"
HOST="0.0.0.0"
# Public check/report/appeal rate-limit keys ignore client-supplied proxy IP
# headers by default. Set to "true" only when the app is behind a trusted edge
# proxy that overwrites/strips spoofed CF-Connecting-IP, X-Real-IP and
# X-Forwarded-For values before requests reach Node.
# TRUST_PROXY_IP_HEADERS="false"
# Required by prod:security-smoke if TRUST_PROXY_IP_HEADERS="true".
# Set only after verifying that the edge proxy overwrites/strips spoofed IP headers.
# TRUST_PROXY_IP_HEADERS_EDGE_VERIFIED="false"

# --- Webhook registration script (scripts/register-telegram-webhook.ts) ---
# Public HTTPS base URL of the deployed app; used to build
# <base>/api/telegram/webhook when registering the Telegram webhook.
PUBLIC_APP_URL="https://your-app.example.com"

# --- Website embed widget (SERVER ONLY runtime config) ---
# Comma/space-separated HTTPS origins allowed to frame /embed/check.
# Example: EMBED_ALLOWED_FRAME_ANCESTORS="https://partner.example https://bank.example"
# If unset, only self + localhost development origins can frame the widget.
# EMBED_ALLOWED_FRAME_ANCESTORS="https://partner.example"

# --- Production monitor / alerting (optional, SERVER ONLY) ---
# Run with: npm run monitor:prod -- https://your-app.example.com
MONITOR_LABEL="production"
MONITOR_TIMEOUT_MS="8000"
MONITOR_MAX_PENDING_UPDATES="0"
MONITOR_STALE_TELEGRAM_ERROR_MS="900000"
# If true, missing TELEGRAM_BOT_TOKEN / TELEGRAM_WEBHOOK_SECRET fails the run.
# Keep false for public GitHub cron, true for a Railway/private scheduler.
# MONITOR_REQUIRE_SECRET_CHECKS="false"
# Optional: send sanitized monitor alerts to an operator Telegram chat.
# Uses TELEGRAM_BOT_TOKEN unless MONITOR_ALERT_BOT_TOKEN is set.
# MONITOR_ALERT_CHAT_ID="123456789"
# MONITOR_ALERT_ON_WARN="false"
# MONITOR_FAIL_ON_WARN="false"
