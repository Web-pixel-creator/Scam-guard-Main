# Copy this file to .env and fill in real values. Never commit .env.
# All secrets are server-only. Do NOT put service-role or AI keys in VITE_* vars.

# --- Supabase (client-safe: publishable/anon key + URL) ---
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"
VITE_SUPABASE_URL="https://your-project.supabase.co"

# --- Supabase service-role (SERVER ONLY — never expose to client) ---
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# --- AI explanation provider (SERVER ONLY; OpenAI-compatible Chat Completions) ---
# Optional: if OPENAI_API_KEY is unset, scoring still works and explanation = null.
# OPENAI_BASE_URL lets you point at any OpenAI-compatible gateway (OpenAI,
# OpenRouter, Together, a local server, …). OPENAI_MODEL must be vision-capable
# for screenshot OCR (default: gpt-4o-mini).
OPENAI_API_KEY="sk-your-openai-key"
OPENAI_MODEL="gpt-4o-mini"
OPENAI_BASE_URL="https://api.openai.com/v1"

# --- Telegram bot (SERVER ONLY) ---
TELEGRAM_BOT_TOKEN="123456:your-bot-token"
TELEGRAM_WEBHOOK_SECRET="your-webhook-secret"

# --- Node server runtime (Nitro node-server preset) ---
# The production server (dist/server/index.mjs) listens on these.
PORT="3000"
HOST="0.0.0.0"

# --- Webhook registration script (scripts/register-telegram-webhook.ts) ---
# Public HTTPS base URL of the deployed app; used to build
# <base>/api/telegram/webhook when registering the Telegram webhook.
PUBLIC_APP_URL="https://your-app.example.com"

